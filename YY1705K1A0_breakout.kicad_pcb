  (segment (start 4.7500 47.0000) (end 5.2500 47.0000) (width 0.250) (layer "F.Cu") (net 1) (uuid "3v3-l05"))

  ;; Top bus: J1 pin1 up → right bus → branches to R2, R3, C2, C1
